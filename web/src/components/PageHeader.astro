---
interface Props {
  eyebrow?: string;
  title: string;
  dek?: string;
}

const { eyebrow, title, dek } = Astro.props;
---

<header class="mx-auto max-w-[1100px] px-6 pt-12 pb-8 md:pt-16 md:pb-10">
  {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
  <h1 class="font-heading text-3xl font-semibold tracking-tight text-foreground md:text-4xl">
    {title}
  </h1>
  {dek && <p class="mt-3 max-w-[65ch] text-lg text-muted-foreground">{dek}</p>}
  <div class="mt-8 border-b hairline"></div>
</header>
