---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<BaseLayout title="Privacy Policy">
  <PageHeader
    eyebrow="Legal"
    title="Privacy Policy"
    dek="How we collect, use, and protect your information."
  />
  <div class="mx-auto max-w-[65ch] px-6 py-8">
    <div class="prose">
      <p class="text-sm text-muted-foreground italic">
        Draft, pending legal review.
      </p>
      <p>
        This privacy policy is being drafted. It will explain what data we collect, how we use it,
        and what choices you have.
      </p>
    </div>
  </div>
</BaseLayout>
