---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import ComingSoon from '../../components/ComingSoon.astro';
---

<BaseLayout title="Zakat Calculator">
  <PageHeader
    eyebrow="Tools"
    title="Zakat calculator"
    dek="Calculate zakat on cash, gold, silver, and investments."
  />
  <div class="mx-auto max-w-[1100px] px-6 py-8">
    <div class="mb-8 max-w-[65ch]">
      <Disclaimer compact />
    </div>
    <ComingSoon message="The zakat calculator is being built. It will help you work through the calculation step by step." />
  </div>
</BaseLayout>
