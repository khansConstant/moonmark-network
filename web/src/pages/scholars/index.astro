---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
---

<BaseLayout title="Scholars">
  <PageHeader
    eyebrow="Scholars"
    title="Our review process"
    dek="How we plan to work with qualified scholars to verify our content."
  />
  <div class="mx-auto max-w-[65ch] px-6 py-8">
    <div class="prose">
      <p>
        Moonmark Network plans to establish a review process with qualified Islamic scholars and
        finance professionals. Content will be checked for religious accuracy and financial
        correctness before publication.
      </p>
      <p>
        We will clearly distinguish between established rulings and areas where scholars differ.
        Where we are uncertain, we will say so. This page will list the scholars involved once the
        review process is in place.
      </p>
      <p>
        No content on this site has been reviewed by scholars yet. We are building the process now.
      </p>
    </div>
  </div>
</BaseLayout>
